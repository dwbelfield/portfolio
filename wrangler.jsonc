{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-09-03",
  // Serve only on the custom domain; the workers.dev copy would be a duplicate origin for search engines.
  "workers_dev": false,
  "preview_urls": false,
  // A small Worker that adds HTTP range support for /media/* (Safari needs it to play video).
  "main": "worker/index.js",
  // Static export from `next build` lands in ./out; serve it as Worker assets.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Only media requests run the Worker; every other path is served straight from assets.
    "run_worker_first": ["/media/*"]
  }
}
