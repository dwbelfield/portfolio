{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-09-03",
  // Serve only on the custom domain; the workers.dev copy would be a duplicate origin for search engines.
  "workers_dev": false,
  "preview_urls": false,
  // Static export from `next build` lands in ./out; serve it as Worker assets.
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
